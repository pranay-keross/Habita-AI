			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"if (pm.response.code === 200) {",
									"    const json = pm.response.json();",
									"    pm.test(\"Response has message\", function () {",
									"        pm.expect(json.message).to.be.a('string');",
									"    });",
									"    if (json.devOtp) {",
									"        pm.collectionVariables.set(\"otp\", json.devOtp);",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"{{phone}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "auth", "register" ]
						},
						"description": "Creates a new (unverified) User row for `phone` if one doesn't already exist, then issues an OTP with purpose REGISTER. Fails if the phone is already a **verified** user. Public endpoint — no token required."
					},
