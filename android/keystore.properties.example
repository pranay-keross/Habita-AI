# Copy this file to android/keystore.properties (that exact filename is
# gitignored — see .gitignore — so it never gets committed) and fill in your
# real release keystore details. android/app/build.gradle reads it to sign
# release builds; without it, release builds fall back to the debug keystore
# and print a warning during the Gradle build.
#
# Generate a real release keystore (do this once, then keep the .keystore file
# and these passwords somewhere safe — losing them means you can never publish
# an update to an app already on the Play Store under the same signature):
#
#   keytool -genkeypair -v -storetype PKCS12 -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias my-key-alias \
#     -keystore android/app/release.keystore
#
# RELEASE_STORE_FILE is resolved relative to android/app/ (same convention as
# the debug.keystore already there), so the default below matches the keytool
# command above if you keep the file in android/app/.

RELEASE_STORE_FILE=release.keystore
RELEASE_STORE_PASSWORD=CHANGE_ME
RELEASE_KEY_ALIAS=my-key-alias
RELEASE_KEY_PASSWORD=CHANGE_ME
