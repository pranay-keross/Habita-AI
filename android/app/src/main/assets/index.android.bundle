91a\u093e\u0930 \u0905\u0917\u0930 \u0915\u094b\u0908 \u092e\u093f\u0924\u094d\u0930 \u0915\u0939\u0924\u0940, \u0924\u094b \u0906\u092a \u0909\u0938\u0947 \u0915\u094d\u092f\u093e \u091c\u0935\u093e\u092c \u0926\u0947\u0924\u0940\u0902?",cbt_grounding_title:"\u0916\u0941\u0926 \u0915\u094b \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 \u0932\u093e\u090f\u0901",cbt_grounding_step_1:"\u0926\u094b\u0928\u094b\u0902 \u092a\u0948\u0930 \u091c\u093c\u092e\u0940\u0928 \u092a\u0930 \u091f\u093f\u0915\u093e\u090f\u0901 \u0914\u0930 \u0915\u0941\u0930\u094d\u0938\u0940 \u092a\u0930 \u092a\u0921\u093c\u0924\u093e \u0905\u092a\u0928\u093e \u092d\u093e\u0930 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0947\u0902\u0964",cbt_grounding_step_2:"\u092a\u093e\u0901\u091a \u091a\u0940\u091c\u093c\u0947\u0902 \u091c\u094b \u0926\u093f\u0916 \u0930\u0939\u0940 \u0939\u0948\u0902, \u091a\u093e\u0930 \u091c\u094b \u0938\u0941\u0928\u093e\u0908 \u0926\u0947 \u0930\u0939\u0940 \u0939\u0948\u0902, \u0914\u0930 \u0924\u0940\u0928 \u091c\u093f\u0928\u094d\u0939\u0947\u0902 \u091b\u0942 \u0938\u0915\u0924\u0940 \u0939\u0948\u0902 \u2014 \u0917\u093f\u0928\u0947\u0902\u0964",cbt_grounding_step_3:"\u0906\u091c \u0915\u0940 \u0924\u093e\u0930\u0940\u0916\u093c \u0914\u0930 \u0906\u092a \u0915\u0939\u093e\u0901 \u0939\u0948\u0902, \u092f\u0939 \u092e\u0928 \u092e\u0947\u0902 \u092f\u093e \u092c\u094b\u0932\u0915\u0930 \u0915\u0939\u0947\u0902\u0964",cbt_grounding_prompt:"\u0907\u0938 \u0915\u092e\u0930\u0947 \u092e\u0947\u0902 \u090f\u0915 \u091a\u0940\u091c\u093c \u0915\u094c\u0928-\u0938\u0940 \u0939\u0948 \u091c\u094b \u0905\u092d\u0940 \u0938\u091a\u092e\u0941\u091a \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u0948?",cbt_breathing_title:"\u0938\u093e\u0901\u0938 \u0915\u094b \u0927\u0940\u092e\u093e \u0915\u0930\u0947\u0902",cbt_breathing_step_1:"\u0928\u093e\u0915 \u0938\u0947 \u091a\u093e\u0930 \u0924\u0915 \u0917\u093f\u0928\u0924\u0947 \u0939\u0941\u090f \u0938\