 \u0648\u0628\u0625\u0631\u0634\u0627\u062f \u0637\u0628\u064a.",stage_fertility_nutrition_2:"\u0623\u062f\u062e\u0644\u064a \u0627\u0644\u062d\u0628\u0648\u0628 \u0627\u0644\u0643\u0627\u0645\u0644\u0629 \u0648\u0627\u0644\u0628\u0642\u0648\u0644\u064a\u0627\u062a \u0648\u0627\u0644\u062f\u0647\u0648\u0646 \u0627\u0644\u0635\u062d\u064a\u0629\u061b \u0648\u0642\u0644\u0651\u0644\u064a \u0627\u0644\u0643\u062d\u0648\u0644 \u0648\u0627\u0644\u0643\u0627\u0641\u064a\u064a\u0646 \u0627\u0644\u0632\u0627\u0626\u062f.",stage_fertility_nutrition_3:"\u0627\u0633\u062a\u0634\u064a\u0631\u064a \u0627\u0644\u0637\u0628\u064a\u0628\u0629 \u0628\u0634\u0623\u0646 \u0641\u064a\u062a\u0627\u0645\u064a\u0646 D \u0648B12 \u0628\u062f\u0644 \u0627\u0644\u062a\u062e\u0645\u064a\u0646 \u0641\u064a \u0627\u0644\u0645\u0643\u0645\u0651\u0644\u0627\u062a.",stage_fertility_exercise_1:"\u0627\u0644\u0646\u0634\u0627\u0637 \u0627\u0644\u0645\u0639\u062a\u062f\u0644 \u0645\u0639\u0638\u0645 \u0627\u0644\u0623\u064a\u0627\u0645 \u064a\u062f\u0639\u0645 \u0627\u0644\u062e\u0635\u0648\u0628\u0629 \u0623\u0643\u062b\u0631 \u0645\u0646 \u0627\u0644\u062c\u0644\u0633\u0627\u062a \u0627\u0644\u0637\u0648\u064a\u0644\u0629 \u0627\u0644\u0634\u062f\u064a\u062f\u0629.",stage_fertility_exercise_2:"\u062a\u0645\u0627\u0631\u064a\u0646 \u0627\u0644\u0642\u0648\u0629 \u0645\u0631\u062a\u064a\u0646 \u0623\u0633\u0628\u0648\u0639\u064a\u064b\u0627 \u062a\u062d\u0633\u0651\u0646 \u062d\u0633\u0627\u0633\u064a\u0629 \u0627\u0644\u0625\u0646\u0633\u0648\u0644\u064a\u0646\u060c \u0648\u0647\u064a \u0645\u0647\u0645\u0629 \u0644\u0644\u0625\u0628\u0627\u0636\u0629.",stage_fertility_exercise_3:"\u0627\u062d\u0645\u064a \u0646\u0648\u0645\u0643 \u0648\u062a\u0639\u0627\u0645\u0644\u064a \u0645\u0639 \u0627\u0644\u062a\u0648\u062a\u0631 \u2014 \u0641\u062a\u0623\u062b\u064a\u0631\u0647\u0645\u0627 \u0639\u0644\u0649 \u0627\u0644\u062f\u0648\u0631\u0629 \u0644\u0627 \u064a\u0642\u0644\u0651 \u0639\u0646 \u0627\u0644\u062a\u0645\u0631\u064a\u0646.",stage_postpartum_name:"\u0645\u0627 \u0628\u0639\u062f \u0627\u0644\u0648\u0644\u0627\u062f\u0629",stage_postpartum_desc:"\u0627\u0644\u062a\u0639\u0627\u0641\u064a \u0628\u0639\u062f \u0627\u0644\u0648\u0644\u0627\u062f\u0629. \u063a\u0627\u0644\u0628\u064b\u0627 \u062a\u0639\u0648\u062f \u0627\u0644\u062f\u0648\u0631\u0629 \u0645\u062a\u0623\u062e\u0631\u0629 \u0648\u063a\u064a\u0631 \u0645\u0646\u062a\u0638\u0645\u0629\u060c \u062e\u0635\u0648\u0635\u064b\u0627 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0631\u0636\u0627\u0639\u0629\u060c \u0644\u0630\u0627 \u062a\u0628\u0642\u0649 \u0627\u0644\u062a\u0648\u0642\u0651\u0639\u0627\u062a \u0645\u062a\u062d\u0641\u0651\u0638\u0629 \u0639\u0646 \u0642\u0635\u062f.",stage_postpartum_nutrition_1:"\u062a\u0646\u0627\u0648\u0644\u064a \u0627\u0644\u0637\u0639\u0627\u0645 \u0628\u0627\u0646\u062a\u0638\u0627\u0645 \u0648\u0627\u0634\u0631\u0628\u064a \u0623\u0643\u062b\u0631 \u0645\u0646 \u0627\u0644\u0645\u0639\u062a\u0627\u062f\u060c \u062e\u0635\u0648\u0635\u064b\u0627 \u0625\u0646 \u0643\u0646\u062a\u0650 \u062a\u0631\u0636\u0639\u064a\u0646.",stage_postpartum_nutrition_2:"\u062d\u0627\u0641\u0638\u064a \u0639\u0644\u0649 \u0627\u0644\u0628\u0631\u0648\u062a\u064a\u0646 \u0648\u0627\u0644\u062d\u062f\u064a\u062f \u0648\u0627\u0644\u0643\u0627\u0644\u0633\u064a\u0648\u0645 \u0628\u064a\u0646\u0645\u0627 \u064a\u0639\u064a\u062f \u062c\u0633\u0645\u0643 \u0628\u0646\u0627\u0621 \u0645\u062e\u0632\u0648\u0646\u0647.",stage_postpartum_nutrition_3:"\u0648\u0627\u0635\u0644\u064a \u0623\u064a \u0645\u0643\u0645\u0651\u0644\u0627\u062a \u0645\u0648\u0635\u0648\u0641\u0629 \u062d\u062a\u0649 \u062a\u0642\u0648\u0644 \u0637\u0628\u064a\u0628\u062a\u0643 \u063a\u064a\u0631 \u0630\u0644\u0643.",stage_postpartum_exercise_1:"\u0627\u0628\u062f\u0626\u064a \u0628\u0627\u0644\u0645\u0634\u064a \u0648\u062a\u0645\u0627\u0631\u064a\u0646 \u0627\u0644\u062a\u0646\u0641\u0651\u0633\u060c \u0648\u0627\u0