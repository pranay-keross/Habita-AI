\u0639\u0644\u0649 \u0627\u0644\u0623\u0631\u0636 \u0648\u0644\u0627\u062d\u0638\u064a \u062b\u0642\u0644 \u062c\u0633\u0645\u0643 \u0639\u0644\u0649 \u0627\u0644\u0645\u0642\u0639\u062f.",cbt_grounding_step_2:"\u0633\u0645\u0651\u064a \u062e\u0645\u0633\u0629 \u0623\u0634\u064a\u0627\u0621 \u062a\u0631\u064a\u0646\u0647\u0627\u060c \u0648\u0623\u0631\u0628\u0639\u0629 \u062a\u0633\u0645\u0639\u064a\u0646\u0647\u0627\u060c \u0648\u062b\u0644\u0627\u062b\u0629 \u064a\u0645\u0643\u0646\u0643 \u0644\u0645\u0633\u0647\u0627.",cbt_grounding_step_3:"\u0642\u0648\u0644\u064a \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0648\u0623\u064a\u0646 \u0623\u0646\u062a\u0650\u060c \u0628\u0635\u0648\u062a \u0645\u0633\u0645\u0648\u0639 \u0623\u0648 \u0641\u064a \u0646\u0641\u0633\u0643.",cbt_grounding_prompt:"\u0645\u0627 \u0627\u0644\u0634\u064a\u0621 \u0627\u0644\u0645\u0648\u062c\u0648\u062f \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u063a\u0631\u0641\u0629 \u0648\u0627\u0644\u0622\u0645\u0646 \u0641\u0639\u0644\u064b\u0627 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0644\u062d\u0638\u0629\u061f",cbt_breathing_title:"\u0623\u0628\u0637\u0626\u064a \u0627\u0644\u062a\u0646\u0641\u0651\u0633",cbt_breathing_step_1:"\u0627\u0633\u062a\u0646\u0634\u0642\u064a \u0645\u0646 \u0623\u0646\u0641\u0643 \u0645\u0639 \u0627\u0644\u0639\u062f\u0651 \u0625\u0644\u0649 \u0623\u0631\u0628\u0639\u0629.",cbt_breathing_step_2:"\u0627\u062d\u0628\u0633\u064a \u0627\u0644\u0646\u0641\u0633 \u0628\u0631\u0641\u0642 \u0623\u0631\u0628\u0639 \u0639\u062f\u0651\u0627\u062a\u060c \u062b\u0645 \u0627\u0632\u0641\u0631\u064a \u0645\u0639 \u0627\u0644\u0639\u062f\u0651 \u0625\u0644\u0649 \u0633\u062a\u0629.",cbt_breathing_step_3:"\u0643\u0631\u0651\u0631\u064a \u0633\u062a \u0645\u0631\u0627\u062a\u060c \u0648\u0627\u062c\u0639\u0644\u064a \u0627\u0644\u0632\u0641\u064a\u0631 \u0623\u0637\u0648\u0644 \u0645\u0646 \u0627\u0644\u0634\u0647\u064a\u0642.",cbt_breathing_prompt:"\u0645\u0627 \u0627\u0644\u0630\u064a \u0627\u062e\u062a\u0644\u0641 \u0641\u064a \u0643\u062a\u0641\u064a\u0643 \u0648\u0641\u0643\u0651\u0643 \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0645\u0627 \u0643\u0627\u0646 \u0642\u0628\u0644 \u062f\u0642\u064a\u0642\u0629\u061f",cbt_gratitude_title:"\u0644\u0627\u062d\u0638\u064a \u0645\u0627 \u062b\u0628\u062a",cbt_gratitude_step_1:"\u0627\u0630\u0643\u0631\u064a \u0634\u064a\u0626\u064b\u0627 \u0648\u0627\u062d\u062f\u064b\u0627 \u0633\u0627\u0631 \u0627\u0644\u064a\u0648\u0645 \u0643\u0645\u0627 \u062a\u0645\u0646\u0651\u064a\u062a\u0650\u060c \u0645\u0647\u0645\u0627 \u0643\u0627\u0646 \u0635\u063a\u064a\u0631\u064b\u0627.",cbt_gratitude_step_2:"\u0627\u0630\u0643\u0631\u064a \u0634\u062e\u0635\u064b\u0627 \u0633\u0647\u0651\u0644 \u0639\u0644\u064a\u0643 \u064a\u0648\u0645\u0643\u060c \u0648\u0643\u064a\u0641 \u0641\u0639\u0644 \u0630\u0644\u0643.",cbt_gratitude_step_3:"\u0627\u0630\u0643\u0631\u064a \u0634\u064a\u0626\u064b\u0627 \u0641\u0639\u0644\u062a\u0650\u0647 \u0628\u0646\u0641\u0633\u0643 \u0648\u0644\u0627 \u064a\u0646\u0628\u063a\u064a \u0623\u0646 \u064a\u0645\u0631\u0651 \u062f\u0648\u0646 \u0627\u0646\u062a\u0628\u0627\u0647.",cbt_gratitude_prompt:"\u0623\u064a\u0651 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u062b\u0644\u0627\u062b\u0629 \u064a\u0633\u062a\u062d\u0642 \u0623\u0646 \u062a\u062d\u0645\u0644\u064a\u0647 \u0645\u0639\u0643 \u0625\u0644\u0649 \u0627\u0644\u063a\u062f\u061f",med_title:"\u062a\u0623\u0645\u0644\u0627\u062a \u0645\u0648\u062c\u064e\u0651\u0647\u0629",med_sub:"\u062c\u0644\u0633\u0627\u062a \u0645\u0631\u062a\u0651\u0628\u0629 \u0628\u062e\u0637\u0648\u0627\u062a \u064a\u0645\u0643\u0646 \u0627\u062a\u0651\u0628\u0627\u0639\u0647\u0627 \u062f\u0648\u0646 \u0635\u0648\u062a \u0623\u0648 \u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a",med_minutes:"{{count}} \u062f\u0642\u064a\u0642\u0629",med_note:"\u062a\u0642\u062f\u0651\u0645\u064a \u0639\u0644\u0649 \u0648\u062a\u064a\u0631\u062a\u0643. \u0627\u0644\u062a\u0648\u0642\u0651\u0641 \u0645\u0628\u0643\u0631\u064b\u0627 \u0644\u0627 \u0628\u0623\u0633 \u0628\u0647 \u2014 \u062c\u0644\u0633\u0629 \u0642\u0635\u064a\u0631\u0629 \u062a\u064f\u0643\u0645\u0644\u064a\u0646\u0647\u0627 \u0623\u0641\u0636\u0644 \u0645\u0646 \u0637\u0648\u064a\u0644\u0629 \u062a\u062e\u0634\u064a\u0646 \u0627\u0644\u0628\u062f\u0621 \u0628\u0647\u0627.",med_done:"\u062a\u0645",med_cat_breath:"\u0627\u0644\u062a\u0646\u0641\u0651\u0633",med_cat_calm:"\u0627\u0644\u0647\u062f\u0648\u0621",med_cat_sleep:"\u0627\u0644\u0646\u0648\u0645",med_cat_focus:"\u0627\u0644\u062a\u0631\u0643\u064a\u0632",med_box_breath_title:"\u0627\u0644\u062a\u0646\u0641\u0651\u0633 \u0627\u0644\u0631\u0628\u0627\u0639\u064a",med_box_breath_sub:"\u0625\u064a\u0642\u0627\u0639 \u0645\u062a\u0633\u0627\u0648\u064d \u0645\u0646 \u0623\u0631\u0628\u0639 \u0639\u062f\u0651\u0627\u062a\u060c \u062d\u064a\u0646 \u064a\u062a\u0633\u0627\u0631\u0639 \u0627\u0644\u062c\u0633\u0645 \u0623\u0643\u062b\u0631 \u0645\u0645\u0627 \u064a\u062a\u0637\u0644\u0651\u0628\u0647 \u0627\u0644\u0645\u0648\u0642\u0641.",med_box_breath_step_1:"\u0627\u062c\u0644\u0633\u064a \u0645\u0639\u062a\u062f\u0644\u0629\u060c \u0623\u0631\u064a\u062d\u064a \u064a\u062f\u064a\u0643\u060c \u0648\u0623\u063a\u0645\u0636\u064a \u0639\u064a\u0646\u064a\u0643 \u0623\u0648 \u062e\u0641\u0651\u0641\u064a \u0627\u0644\u0646\u0638\u0631.",med_box_breath_step_2:"\u0627\u0633\u062a\u0646\u0634\u0642\u064a \u0623\u0631\u0628\u0639 \u0639\u062f\u0651\u0627\u062a\u060c \u0648\u0627\u062d\u0628\u0633\u064a \u0623\u0631\u0628\u0639\u064b\u0627.",med_box_breath_step_3:"\u0627\u0632\u0641\u0631\u064a \u0623\u0631\u0628\u0639 \u0639\u062f\u0651\u0627\u062a\u060c \u062b\u0645 \u062a\u0648\u0642\u0651\u0641\u064a \u0623\u0631\u0628\u0639\u064b\u0627 \u0648\u0627\u0644\u0631\u0626\u062a\u0627\u0646 \u0641\u0627\u0631\u063a\u062a\u0627\u0646.",med_box_breath_step_4:"\u0648\u0627\u0635\u0644\u