0926\u0947\u0916\u093e \u0928\u0939\u0940\u0902 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964",cbt_gratitude_prompt:"\u0907\u0928 \u0924\u0940\u0928\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u0915\u094c\u0928-\u0938\u0940 \u092c\u093e\u0924 \u0915\u0932 \u0924\u0915 \u0938\u093e\u0925 \u0932\u0947 \u091c\u093e\u0928\u0947 \u0932\u093e\u092f\u0915 \u0939\u0948?",med_title:"\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u0927\u094d\u092f\u093e\u0928",med_sub:"\u092c\u093f\u0928\u093e \u0906\u0935\u093e\u091c\u093c \u0914\u0930 \u092c\u093f\u0928\u093e \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0947 \u092d\u0940 \u0915\u093f\u090f \u091c\u093e \u0938\u0915\u0928\u0947 \u0935\u093e\u0932\u0947 \u0915\u094d\u0930\u092e\u092c\u0926\u094d\u0927 \u0938\u0924\u094d\u0930",med_minutes:"{{count}} \u092e\u093f\u0928\u091f",med_note:"\u0905\u092a\u0928\u0940 \u0917\u0924\u093f \u0938\u0947 \u0915\u0930\u0947\u0902\u0964 \u092c\u0940\u091a \u092e\u0947\u0902 \u0930\u094b\u0915 \u0926\u0947\u0928\u093e \u092d\u0940 \u0920\u0940\u0915 \u0939\u0948 \u2014 \u091c\u094b \u091b\u094b\u091f\u093e \u0938\u0924\u094d\u0930 \u0906\u092a \u092a\u0942\u0930\u093e \u0915\u0930 \u0932\u0947\u0902, \u0935\u0939 \u0909\u0938 \u0932\u0902\u092c\u0947 \u0938\u0924\u094d\u0930 \u0938\u0947 \u092c\u0947\u0939\u0924\u0930 \u0939\u0948 \u091c\u093f\u0938\u0938\u0947 \u0921\u0930 \u0932\u0917\u0947\u0964",med_done:"\u092a\u0942\u0930\u093e \u0939\u0941\u0906",med_cat_breath:"\u0938\u093e\u0901\u0938",med_cat_calm:"\u0936\u093e\u0902\u0924\u093f",med_cat_sleep:"\u0928\u0940\u0902\u0926",med_cat_focus:"\u0927\u094d\u092f\u093e\u0928",med_box_breath_title:"\u092c\u0949\u0915\u094d\u0938 \u092c\u094d\u0930\u0940\u0926\u093f\u0902\u0917",med_box_breath_sub:"\u091a\u093e\u0930-\u091a\u093e\u0930 \u0917\u093f\u0928\u0924\u0940 \u0915\u0940 \u090f\u0915 \u0938\u092e\u093e\u0928 \u0932\u092f, \u091c\u092c \u0936\u0930\u0940\u0930 \u091c\u093c\u0930\u0942\u0930\u0924 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0924\u0947\u091c\u093c \u091a\u0932 \u0930\u0939\u093e \u0939\u094b\u0964",med_box_breath_step_1:"\u0938\u0940\u0927\u0940 \u092c\u0948\u0920\u0947\u0902, \u0939\u093e\u0925 \u0906\u0930\u093e\u092e \u0938\u0947 \u0930\u0916\u0947\u0902, \u0914\u0930 \u0906\u0901\u0916\u0947\u0902 \u092c\u0902\u0926 \u092f\u093e \u0939\u0932\u094d\u0915\u0940 \u0915\u0930 \u0932\u0947\u0902\u0964",med_box_breath_step_2:"\u091a\u093e\u0930 \u0917\u093f\u0928\u0924\u0940 \u0924\u0915 \u0938\u093e\u0901\u0938 \u092d\u0940\u0924\u0930 \u0932\u0947\u0902, \u091a\u093e\u0930 \u0924\u0915 \u0930\u094b\u0915\u0947\u0902\u0964",med_box_breath_step_3:"\u091a\u093e\u0930 \u0917\u093f\u0928\u0924\u0940 \u0924\u0915 \u091b\u094b\u0921\u093c\u0947\u0902, \u092b\u093f\u0930 \u0916\u093e\u0932\u0940 \u092b\u0947\u092b\u0921\u093c\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u091a\u093e\u0930 \u0924\u0915 \u0930\u0941\u0915\u0947\u0902\u0964",med_box_breath_step_4:"\u0938\u094b\u0932\u0939 \u091a\u0915\u094d\u0930 \u0924\u0915 \u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902, \u092b\u093f\u0930 \u0909\u0920\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u090f\u0915 \u0915\u094d\u0937\u0923 \u0938\u094d\u0925\u093f\u0930 \u092c\u0948\u0920\u0947\u0902\u0964",med_body_scan_title:"\u092c\u0949\u0921\u0940 \u0938\u094d\u0915\u0948\u0928",med_body_scan_sub:"\u0938\u093f\u0930 \u0938\u0947 \u092a\u0948\u0930 \u0924\u0915 \u0927\u0940\u092e\u0940 \u092f\u093e\u0924\u094d\u0930\u093e, \u0924\u093e\u0915\u093f \u0926\u093f\u0928 \u092d\u0930 \u092e\u0947\u0902 \u091a\u0941\u092a\u091a\u093e\u092a \u091c\u092e\u093e \u0939\u0941\u0906 \u0924\u0928\u093e\u0935 \u091b\u0942\u091f \u091c\u093e\u090f\u0964",med_body_scan_step_1:"\u0932\u0947\u091f \u091c\u093e\u090f\u0901 \u092f\u093e \u092a\u0940\u091b\u0947 \u091f\u093f\u0915\u0915\u0930 \u092c\u0948\u0920\u0947\u0902, \u0914\u0930 \u0924\u0940\u0928 \u092c\u093f\u0928\u093e \u091c\u0932\u094d\u0926\u092c\u093e\u091c\u093c\u0940 \u0915\u0940 \u0938\u093e\u0901\u0938\u0947\u0902 \u0932\u0947\u0902\u0964",med_body_scan_step_2:"\u0927\u094d\u092f\u093e\u0928 \u0938\u093f\u0930, \u091a\u0947\u0939\u0930\u0947 \u0914\u0930 \u091c\u092c\u0921\u093c\u0947 \u092a\u0930 \u0932\u093e\u090f\u0901, \u0914\u0930 \u0939\u0930 \u0938\u093e\u0901\u0938 \u091b\u094b\u0921\u093c\u0924\u0947 \u0939\u0941\u090f \u0909\u0928\u094d\u0939\u0947\u0902 \u0922\u0940\u0932\u093e \u0939\u094b\u0928\u0947 \u0926\u0947\u0902\u0964",med_body_scan_step_3:"\u0915\u0902\u0927\u0947, \u092c\u093e\u0901\u0939\u0947\u0902, \u091b\u093e\u0924\u0940, \u092a\u0947\u091f, \u0915\u0942\u0932\u094d\u0939\u0947 \u0914\u0930 \u092a\u0948\u0930 \u2014 \u0939\u0930 \u0939\u093f\u0938\u094d\u0938\u0947 \u092a\u0930 \u0930\u0941\u0915\u0924\u0947 \u0939\u0941\u090f \u0928\u0940\u091a\u0947 \u092c\u0922\u093c\u0947\u0902\u0964",med_body_scan_step_4:"\u092a\u0948\u0930\u094b\u0902 \u092a\u0930 \u092a\u0939\u0941\u0901\u091a\u0915\u0930 \u0930\u0941\u0915\u0947\u0902, \u092b\u093f\u0930 \u0906\u0916\u093c\u093f\u0930\u0940 \u090f\u0915 \u092e\u093f\u0928\u091f \u092a\u0942\u0930\u0947 \u0936\u0930\u0940\u0930 \u0915\u094b \u090f\u0915 \u0938\u093e\u0925 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0947\u0902\u0964",med_wind_down_title:"\u0936\u093e\u092e \u0915\u0940 \u0936\u093e\u0902\u0924\u093f",med_wind_down_sub:"\u0926\u093f\u0928 \u0915\u094b \u0938\u092e\u0947\u091f\u0928\u0947 \u0915\u0947 \u0926\u0938 \u092e\u093f\u0928\u091f, \u091c\u092c \u092c\u0924\u094d\u0924\u0940 \u092c\u0941\u091d\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u092d\u0940 \u092e\u0928 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0930\u0939\u0924\u093e \u0939\u0948\u0964",med_wind_down_step_1:"\u092b\u093c\u094b\u0928 \u0909\u0932\u091f\u093e \u0930\u0916 \u0926\u0947\u0902 \u0914\u0930 \u0915\u092e\u0930\u0947 \u0915\u0940 \u0930\u094b\u0936\u0928\u0940 \u0927\u0940\u092e\u0940 \u0915\u0930 \u0932\u0947\u0902\u0964",med_wind_down_step_2:"\u092a\u093e\u0901\u091a \u092c\u093e\u0930 \u0927\u0940\u0930\u0947-\u0927\u0940\u0930\u0947 \u0938\u093e\u0901\u0938 \u091b\u094b\u0921\u093c\u0947\u0902 \u2014 \u092d\u0940\u0924\u0930 \u0932\u0947\u0928\u0947 \u0938\u0947 \u0932\u0902\u092c\u0940\u0964",med_wind_down_step_3:"\u0906\u091c \u0915\u0940 \u0924\u0940\u0928 \u092c\u093e\u0924\u0947\u0902 \u092c\u0924\u093e\u090f\u0901 \u091c\u093f\u0928\u094d\u0939\u0947\u0902 \u0906\u092a \u0915\u0932 \u0924\u0915 \u0915\u0947 \u0932\u093f\u090f \u0930\u0916 \u0930\u0939\u0940 \u0939\u0948\u0902\u0964",med_wind_down_step_4:"\u0927\u094d\u092f\u093e\u0928 \u091a\u093e\u0926\u0930 \u0915\u0947 \u092d\u093e\u0930 \u092f\u093e \u0915\u092e\u0930\u0947 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u092a\u0930 \u091f\u093f\u0915\u093e\u090f\u0901, \u0914\u0930 \u0935\u0939\u0940\u0902 \u0930\u0939\u0928\u0947 \u0926\u0947\u0902\u0964",med_focus_reset_title:"\u0924\u0940\u0928 \u092e\u093f\u0928\u091f \u0915\u093e \u0930\u0940\u0938\u0947\u091f",med_focus_reset_sub:"\u0926\u094b \u0915\u093e\u092e\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0915\u093e \u091b\u094b\u091f\u093e \u0920\u0939\u0930\u093e\u0935, \u091c\u092c \u0927\u094d\u092f\u093e\u0928 \u092c\u093f\u0916\u0930 \u0917\u092f\u093e \u0939\u094b \u092a\u0930 \u0926\u093f\u0928 \u092c\u093e\u0915\u093c\u0940 \u0939\u094b\u0964",med_focus_reset_step_1:"\u091c\u094b \u0915\u0930 \u0930\u0939\u0940 \u0939\u0948\u0902 \u0909\u0938\u0947 \u0930\u094b\u0915\u0947\u0902 \u0914\u0930 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0938\u0947 \u092a\u0940\u091b\u0947 \u0939\u091f \u091c\u093e\u090f\u0901\u0964",med_focus_reset_step_2:"\u090f\u0915 \u092e\u093f\u0928\u091f \u0924\u0915 \u091c\u094b \u092e\u0939\u0938\u0942\u0938 \u0939\u094b \u0930\u0939\u093e \u0939\u0948, \u0909\u0938\u0947 \u092c\u0926\u0932\u0947 \u092c\u093f\u0928\u093e \u0926\u0947\u0916\u0947\u0902\u0964",med_focus_reset_step_3:"\u090f\u0915 \u092e\u093f\u0928\u091f \u0924\u0915 \u0938\u093e\u0901\u0