5\u0631\u062d\u0644\u0629 \u0627\u0644\u0639\u0645\u0631\u064a\u0629",stage_sub:"\u0647\u0630\u0627 \u064a\u063a\u064a\u0651\u0631 \u0645\u0627 \u064a\u064f\u062a\u0648\u0642\u064e\u0651\u0639 \u0648\u0623\u064a \u0625\u0631\u0634\u0627\u062f \u064a\u064f\u0639\u0631\u0636",stage_cycling_name:"\u062a\u062a\u0628\u0651\u0639 \u0639\u0627\u062f\u064a",stage_cycling_desc:"\u062a\u062a\u0628\u0651\u0639 \u0627\u0639\u062a\u064a\u0627\u062f\u064a \u0644\u0644\u062f\u0648\u0631\u0629\u060c \u0645\u0639 \u062a\u0648\u0642\u0651\u0639\u0627\u062a \u0644\u0644\u062f\u0648\u0631\u0629 \u0627\u0644\u0642\u0627\u062f\u0645\u0629 \u0648\u0627\u0644\u0625\u0628\u0627\u0636\u0629 \u0648\u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u062e\u0635\u0648\u0628\u0629.",stage_cycling_nutrition_1:"\u062d\u0627\u0641\u0638\u064a \u0639\u0644\u0649 \u0627\u0644\u062d\u062f\u064a\u062f \u0642\u0631\u0628 \u0645\u0648\u0639\u062f \u0627\u0644\u062f\u0648\u0631\u0629 \u2014 \u0627\u0644\u0628\u0642\u0648\u0644\u064a\u0627\u062a \u0648\u0627\u0644\u062e\u0636\u0627\u0631 \u0627\u0644\u0648\u0631\u0642\u064a\u0629 \u0627\u0644\u062f\u0627\u0643\u0646\u0629\u060c \u0648\u0627\u0644\u0644\u062d\u0648\u0645 \u0623\u0648 \u0627\u0644\u0633\u0645\u0643 \u0625\u0646 \u0643\u0646\u062a\u0650 \u062a\u062a\u0646\u0627\u0648\u0644\u064a\u0646\u0647\u0627.",stage_cycling_nutrition_2:"\u0627\u062c\u0645\u0639\u064a \u0627\u0644\u0623\u0637\u0639\u0645\u0629 \u0627\u0644\u063a\u0646\u064a\u0629 \u0628\u0627\u0644\u062d\u062f\u064a\u062f \u0645\u0639 \u0641\u064a\u062a\u0627\u0645\u064a\u0646 C\u060c \u0643\u0627\u0644\u0644\u064a\u0645\u0648\u0646\u060c \u0644\u0632\u064a\u0627\u062f\u0629 \u0627\u0644\u0627\u0645\u062a\u0635\u0627\u0635.",stage_cycling_nutrition_3:"\u0639\u0627\u0644\u062c\u064a \u0647\u0628\u0648\u0637 \u0627\u0644\u0637\u0627\u0642\u0629 \u0641\u064a \u0627\u0644\u0645\u0631\u062d\u0644\u0629 \u0627\u0644\u0623\u0635\u0641\u0631\u064a\u0629 \u0628\u0627\u0644\u0646\u0634\u0648\u064a\u0627\u0