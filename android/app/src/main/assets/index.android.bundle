\u09a5\u09bf\u09b0\u09a4\u09be\u09b0 \u0995\u09bf\u099b\u09c1\u099f\u09be \u0995\u09be\u09b2\u0995\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b0\u09c7\u0996\u09c7 \u09a6\u09bf\u0987\u0964",cbt_tone_bright:"\u09b6\u09c1\u09a8\u09c7 \u09ad\u09be\u09b2\u09cb \u09b2\u09be\u0997\u09b2 \u09af\u09c7 \u098f\u0995\u099f\u09c1 \u09b9\u09be\u09b2\u0995\u09be \u09b2\u09be\u0997\u099b\u09c7\u0964 \u0995\u09c0 \u0995\u09be\u099c\u09c7 \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09bf\u09b2 \u09b8\u09c7\u099f\u09be \u0996\u09c7\u09af\u09bc\u09be\u09b2 \u0995\u09b0\u09be\u0987 \u098f\u0995\u09c7 \u09ac\u09be\u09b0\u09ac\u09be\u09b0 \u09ab\u09bf\u09b0\u09bf\u09af\u09bc\u09c7 \u0986\u09a8\u09a4\u09c7 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u0995\u09b0\u09c7\u0964",cbt_reframe_title:"\u09ad\u09be\u09ac\u09a8\u09be\u099f\u09bf\u0995\u09c7 \u09a8\u09a4\u09c1\u09a8 \u0995\u09b0\u09c7 \u09a6\u09c7\u0996\u09c1\u09a8",cbt_reframe_step_1:"\u09af\u09c7 \u09ad\u09be\u09ac\u09a8\u09be\u099f\u09bf \u09ac\u09be\u09b0\u09ac\u09be\u09b0 \u09ab\u09bf\u09b0\u09c7 \u0986\u09b8\u09c7, \u09a0\u09bf\u0995 \u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09bf\u099c\u09c7\u09b0 \u09ad\u09be\u09b7\u09be\u09af\u09bc \u09b8\u09c7\u099f\u09bf \u09b2\u09bf\u0996\u09c1\u09a8\u0964",cbt_reframe_step_2:"\u09a4\u09be\u09b0 \u09aa\u0995\u09cd\u09b7\u09c7 \u098f\u0995\u099f\u09bf \u098f\u09ac\u0982 \u09ac\u09bf\u09aa\u0995\u09cd\u09b7\u09c7 \u098f\u0995\u099f\u09bf \u09aa\u09cd\u09b0\u09ae\u09be\u09a3 \u09b2\u09bf\u0996\u09c1\u09a8\u0964 \u098f\u0995\u099f\u09bf \u0995\u09b0\u09c7\u0987 \u09af\u09a5\u09c7\u09b7\u09cd\u099f\u0964",cbt_reframe_step_3:"\u098f\u09ac\u09be\u09b0 \u09ad\u09be\u09ac\u09a8\u09be\u099f\u09bf \u098f\u09ae\u09a8\u09ad\u09be\u09ac\u09c7 \u09b2\u09bf\u0996\u09c1\u09a8 \u09af\u09be\u09a4\u09c7 \u09a4\u09be \u09b8\u09a4\u09cd\u09af\u09bf\u0993 \u09a5\u09be\u0995\u09c7, \u0986\u09ac\u09be\u09b0 \u09a6\u09c1\u099f\u09bf \u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c7\u09b0 \u09b8\u0999\u09cd\u0997\u09c7\u0993 \u09ae\u09c7\u09b2\u09c7\u0964",cbt_reframe_prompt:"\u0995\u09cb\u09a8\u09cb \u09ac\u09a8\u09cd\u09a7\u09c1 \u09af\u09a6\u09bf \u098f\u0987 \u0995\u09a5\u09be\u099f\u09be \u09ac\u09b2\u09a4, \u0986\u09aa\u09a8\u09bf \u09a4\u09be\u0995\u09c7 \u0995\u09c0 \u0989\u09a4\u09cd\u09a4\u09b0 \u09a6\u09bf\u09a4\u09c7\u09a8?",cbt_grounding_title:"\u09a8\u09bf\u099c\u09c7\u0995\u09c7 \u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8\u09c7 \u09ab\u09c7\u09b0\u09be\u09a8",cbt_grounding_step_1:"\u09a6\u09c1\u0987 \u09aa\u09be \u09ae\u09c7\u099d\u09c7\u09a4\u09c7 \u09b0\u09be\u0996\u09c1\u09a8 \u098f\u09ac\u0982 \u099a\u09c7\u09af\u09bc\u09be\u09b0\u09c7 \u09a8\u09bf\u099c\u09c7\u09b0 \u0993\u099c\u09a8\u099f\u09be \u0985\u09a8\u09c1\u09ad\u09ac \u0995\u09b0\u09c1\u09a8\u0964",cbt_grounding_step_2:"\u09aa\u09be\u0981\u099a\u099f\u09bf \u099c\u09bf\u09a8\u09bf\u09b8 \u09af\u09be \u09a6\u09c7\u0996\u099b\u09c7\u09a8, \u099a\u09be\u09b0\u099f\u09bf \u09af\u09be \u09b6\u09c1\u09a8\u099b\u09c7\u09a8, \u09a4\u09bf\u09a8\u099f\u09bf \u09af\u09be \u099b\u09c1\u0981\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8 \u2014 \u09a8\u09be\u09ae \u09ac\u09b2\u09c1\u09a8\u0964",cbt_grounding_step_3:"\u0986\u099c\u0995\u09c7\u09b0 \u09a4\u09be\u09b0\u09bf\u0996 \u0986\u09b0 \u0986\u09aa\u09a8\u09bf \u0995\u09cb\u09a5\u09be\u09af\u09bc \u0986\u099b\u09c7\u09a8, \u09ae\u09a8\u09c7 \u09ae\u09a8\u09c7 \u09ac\u09be \u099c\u09cb\u09b0\u09c7 \u09ac\u09b2\u09c1\u09a8\u0964",cbt_grounding_prompt:"\u098f\u0987 \u0998\u09b0\u09c7 \u098f\u09ae\u09a8 \u098f\u0995\u099f\u09bf \u099c\u09bf\u09a8\u09bf\u09b8 \u0995\u09c0, \u09af\u09be \u098f\u0987 \u09ae\u09c1\u09b9\u09c2\u09b0\u09cd\u09a4\u09c7 \u09b8\u09a4\u09cd\u09af\u09bf\u0987 \u09a8\u09bf\u09b0\u09be\u09aa\u09a6?",cbt_breathing_title:"\u09b6\u09cd\u09ac\u09be\u09b8 \u09a7\u09c0\u09b0 \u0995\u09b0\u09c1\u09a8",cbt_breathing_step_1:"\u09a8\u09be\u0995 \u09a6\u09bf\u09af\u09bc\u09c7 \u099a\u09be\u09b0 \u0997\u09c1\u09a8\u09c7 \u09b6\u09cd\u09ac\u09be\u09b8 \u09a8\u09bf\u09a8\u0964",cbt_breathing_step_2:"\u099a\u09be\u09b0 \u0997\u09c1\u09a8\u09c7 \u09b9\u09be\u09b2\u0995\u09be \u09a7\u09b0\u09c7 \u09b0\u09be\u0996\u09c1\u09a8, \u09a4\u09be\u09b0\u09aa\u09b0 \u099b\u09af\u09bc \u0997\u09c1\u09a8\u09c7 \u099b\u09be\u09a1\u09bc\u09c1\u09a8\u0964",cbt_breathing_step_3:"\u099b\u09af\u09bc\u09ac\u09be\u09b0 \u0995\u09b0\u09c1\u09a8, \u0986\u09b0 \u099b\u09be\u09a1\u09bc\u09be\u09b0 \u09b6\u09cd\u09ac\u09be\u09b8 \u09a8\u09c7\u0993\u09af\u09bc\u09be\u09b0 \u099a\u09c7\u09af\u09bc\u09c7 \u09b2\u09ae\u09cd\u09ac\u09be \u09b0\u09be\u0996\u09c1\u09a8\u0964",cbt_breathing_prompt:"\u098f\u0995 \u09ae\u09bf\u09a8\u09bf\u099f \u0986\u0997\u09c7\u09b0 \u09a4\u09c1\u09b2\u09a8\u09be\u09af\u09bc \u0995\u09be\u0981\u09a7 \u0986\u09b0 \u099a\u09cb\u09af\u09bc\u09be\u09b2\u09c7 \u098f\u0996\u09a8 \u0995\u09c0 \u0986\u09b2\u09be\u09a6\u09be \u09b2\u09be\u0997\u099b\u09c7?",cbt_gratitude_title:"\u09af\u09be \u099f\u09bf\u0995\u09c7 \u099b\u09bf\u09b2 \u09a4\u09be \u09a6\u09c7\u0996\u09c1\u09a8",cbt_gratitude_step_1:"\u0986\u099c\u0995\u09c7\u09b0 \u098f\u09ae\u09a8 \u098f\u0995\u099f\u09bf \u09ac\u09bf\u09b7\u09af\u09bc \u09ac\u09b2\u09c1\u09a8 \u09af\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09b6\u09be \u09ae\u09a4\u09cb \u09b9\u09af\u09bc\u09c7\u099b\u09c7, \u09af\u09a4 \u099b\u09cb\u099f\u0987 \u09b9\u09cb\u0995\u0964",cbt_gratitude_step_2:"\u098f\u09ae\u09a8 \u098f\u0995\u099c\u09a8\u09c7\u09b0 \u09a8\u09be\u09ae \u09ac\u09b2\u09c1\u09a8 \u09af\u09bf\u09a8\u09bf \u09a6\u09bf\u09a8\u099f\u09be \u09b8\u09b9\u099c \u0995\u09b0\u09c7\u099b\u09c7\u09a8, \u0986\u09b0 \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u0995\u09b0\u09c7\u099b\u09c7\u09a8\u0964",cbt_gratitude_step_3:"\u09a8\u09bf\u099c\u09c7\u09b0 \u0995\u09b0\u09be \u098f\u09ae\u09a8 \u098f\u0995\u099f\u09bf \u0995\u09be\u099c \u09ac\u09b2\u09c1\u09a8 \u09af\u09c7\u099f\u09bf \u0985\u0997\u09cb\u099a\u09b0\u09c7 \u09a5\u09c7\u0995\u09c7 \u09af\u09be\u0993\u09af\u09bc\u09be \u0989\u099a\u09bf\u09a4 \u09a8\u09af\u0