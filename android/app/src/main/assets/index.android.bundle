094d\u0930\u0947\u091f \u0938\u0947 \u0938\u0902\u092d\u093e\u0932\u0947\u0902\u0964",stage_cycling_exercise_1:"\u092d\u093e\u0930\u0940 \u0915\u0938\u0930\u0924 \u092a\u0940\u0930\u093f\u092f\u0921 \u0915\u0947 \u092c\u093e\u0926 \u0935\u093e\u0932\u0947 \u0938\u092a\u094d\u0924\u093e\u0939 \u0915\u0947 \u0932\u093f\u090f \u0930\u0916\u0947\u0902, \u091c\u092c \u090a\u0930\u094d\u091c\u093e \u0906\u092e\u0924\u094c\u0930 \u092a\u0930 \u0938\u092c\u0938\u0947 \u0905\u0927\u093f\u0915 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964",stage_cycling_exercise_2:"\u0938\u092c\u0938\u0947 \u092d\u093e\u0930\u0940 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0924\u0940\u0935\u094d\u0930\u0924\u093e \u0915\u0940 \u091c\u0917\u0939 \u091f\u0939\u0932\u0928\u093e, \u092f\u094b\u0917 \u092f\u093e \u0938\u094d\u091f\u094d\u0930\u0947\u091a\u093f\u0902\u0917 \u091a\u0941\u0928\u0947\u0902\u0964",stage_cycling_exercise_3:"\u0926\u093f\u0928\u091a\u0930\u094d\u092f\u093e \u092c\u0926\u0932\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0926\u094b \u0938\u093e\u0907\u0915\u093f\u0932 \u0924\u0915 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0939\u0930 \u091a\u0930\u0923 \u0915\u0948\u0938\u093e \u092e\u0939\u0938\u0942\u0938 \u0939\u094b\u0924\u093e \u0939\u0948\u0964",stage_fertility_name:"\u0917\u0930\u094d\u092d\u0927\u093e\u0930\u0923",stage_fertility_desc:"\u0917\u0930\u094d\u092d\u0927\u093e\u0930\u0923 \u0915\u0940 \u092f\u094b\u091c\u0928\u093e\u0964 \u092b\u0930\u094d\u091f\u093e\u0907\u0932 \u0935\u093f\u0902\u0921\u094b \u0914\u0930 \u0913\u0935\u094d\u092f\u0941\u0932\u0947\u0936\u0928 \u0915\u093e \u0905\u0928\u0941\u092e\u093e\u0928 \u092a\u094d\u0930\u092e\u0941\u0916\u0924\u093e \u0938\u0947 \u0926\u093f\u0916\u0924\u093e \u0939\u0948, \u0938\u093e\u0925 \u092e\u0947\u0902 \u0935\u093f\u0902\u0921\u094b \u0916\u0941\u0932\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u090f\u0915 \u092f\u093e\u0926-\u0926\u093f\u0932\u093e\u0935\u093e\u0964",stage_fertility_nutrition_1:"\u0921\u0949\u0915\u094d\u091f\u0930 \u0915\u0940 \u0938\u0932\u093e\u0939 \u092a\u0930 \u0930\u094b\u091c\u093c \u092b\u094b\u0932\u0947\u091f \u0932\u0947\u0902, \u0906\u0926\u0930\u094d\u0936 \u0930\u0942\u092a \u0938\u0947 \u0917\u0930\u094d\u092d\u0927\u093e\u0930\u0923 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0938\u0947\u0964",stage_fertility_nutrition_2:"\u0938\u093e\u092c\u0941\u0924 \u0905\u0928\u093e\u091c, \u0926\u093e\u0932\u0947\u0902 \u0914\u0930 \u0905\u091a\u094d\u091b\u0947 \u0935\u0938\u093e \u0936\u093e\u092e\u093f\u0932 \u0915\u0930\u0947\u0902; \u0936\u0930\u093e\u092c \u0914\u0930 \u0905\u0927\u093f\u0915 \u0915\u0948\u092b\u093c\u0940\u0928 \u0915\u092e \u0930\u0916\u0947\u0902\u0964",stage_fertility_nutrition_3:"\u0938\u092a\u094d\u0932\u0940\u092e\u0947\u0902\u091f \u0915\u093e \u0905\u0902\u0926\u093e\u091c\u093c\u093e \u0932\u0917\u093e\u0928\u0947 \u0915\u0947 \u092c\u091c\u093e\u092f \u0935\u093f\u091f\u093e\u092e\u093f\u0928 D \u0914\u0930 B12 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0921\u0949\u0915\u094d\u091f\u0930 \u0938\u0947 \u092a\u0942\u091b\u0947\u0902\u0964",stage_fertility_exercise_1:"\u0932\u0902\u092c\u0940, \u0924\u0940\u0935\u094d\u0930 \u0915\u0938\u0930\u0924 \u0915\u0940 \u0924\u0941\u0932\u0928\u093e \u092e\u0947\u0902 \u0932\u0917\u092d\u0917 \u0930\u094b\u091c\u093c \u0915\u0940 \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0917\u0924\u093f\u0935\u093f\u0927\u093f \u092a\u094d\u0930\u091c\u0928\u0928 \u0915\u094d\u0937\u092e\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u092c\u0947\u0939\u0924\u0930 \u0939\u0948\u0964",stage_fertility_exercise_2:"\u0938\u092a\u094d\u0924\u093e\u0939 \u092e\u0947\u0902 \u0926\u094b \u092c\u093e\u0930 \u0936\u0915\u094d\u0924\u093f-\u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0907\u0902\u0938\u0941\u0932\u093f\u0928 \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0924\u093e \u0939\u0948, \u091c\u094b \u0913\u0935\u094d\u092f\u0941\u0932\u0947\u0936\u0928 \u0915\u0947 \u0932\u093f\u090f \u092e\u093e\u092f\u0928\u0947 \u0930\u0916\u0924\u093e \u0939\u0948\u0964",stage_fertility_exercise_3:"\u0928\u0940\u0902\u0926 \u0914\u0930 \u0924\u0928\u093e\u0935 \u0915\u093e \u0927\u094d\u092f\u093e\u0928 \u0930\u0916\u0947\u0902 \u2014 \u092f\u0947 \u0938\u093e\u0907\u0915\u093f\u0932 \u092a\u0930 \u0909\u0924\u0928\u093e \u0939\u0940 \u0905\u0938\u0930 \u0921\u093e\u0932\u0924\u0947 \u0939\u0948\u0902 \u091c\u093f\u0924\u0928\u093e \u0915\u0938\u0930\u0924\u0964",stage_postpartum_name:"\u092a\u094d\u0930\u0938\u0935 \u0915\u0947 \u092c\u093e\u0926",stage_postpartum_desc:"\u092a\u094d\u0930\u0938\u0935 \u0915\u0947 \u092c\u093e\u0926 \u0915\u0940 \u0930\u093f\u0915\u0935\u0930\u0940\u0964 \u0938\u093e\u0907\u0915\u093f\u0932 \u0905\u0915\u094d\u0938\u0930 \u0926\u0947\u0930 \u0938\u0947 \u0914\u0930 \u0905\u0928\u093f\u092f\u092e\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0932\u094c\u091f\u0924\u0940 \u0939\u0948, \u0916\u093e\u0938\u0915\u0930 \u0938\u094d\u0924\u0928\u092a\u093e\u0928 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928, \u0907\u0938\u0932\u093f\u090f \u0905\u0928\u0941\u092e\u093e\u0928 \u091c\u093e\u0928\u092c\u0942\u091d\u0915\u0930 \u0938\u0924\u0930\u094d\u0915 \u0930\u0939\u0924\u0947 \u0939\u0948\u0902\u0964",stage_postpartum_nutrition_1:"\u0938\u092e\u092f \u092a\u0930 \u0916\u093e\u090f\u0901 \u0914\u0930 \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0938\u0947 \u0905\u0927\u093f\u0915 \u092a\u093e\u0928\u0940 \u092a\u093f\u090f\u0901, \u0916\u093e\u0938\u0915\u0930 \u092f\u0926\u093f \u0906\u092a \u0938\u094d\u0924\u0928\u092a\u093e\u0928 \u0915\u0930\u093e \u0930\u0939\u0940 \u0939\u0948\u0902\u0964",stage_postpartum_nutrition_2:"\u091c\u092c \u0924\u0915 \u0936\u0930\u0940\u0930 \u0905\u092a\u0928\u0947 \u092d\u0902\u0921\u093e\u0930 \u0926\u094b\u092c\u093e\u0930\u093e \u092c\u0928\u093e\u0924\u093e \u0939\u0948, \u092a\u094d\u0930\u094b\u091f\u0940\u0928, \u0906\u092f\u0930\u0928 \u0914\u0930 \u0915\u0948\u0932\u094d\u0936\u093f\u092f\u092e \u092c\u0928\u093e\u090f \u0930\u0916\u0947\u0902\u0964",stage_postpartum_nutrition_3:"\u0921\u0949\u0915\u094d\u091f\u0930 \u0915\u0947 \u092e\u0928\u093e \u0915\u0930\u0928\u0947 \u0924\u0915 \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0938\u092a\u094d\u0932\u0940\u092e\u0947\u0902\u091f \u0932\u0947\u0924\u0947 \u0930\u0939\u0947\u0902\u0964",stage_postpartum_exercise_1:"\u091f\u0939\u0932\u0928\u0947 \u0914\u0930 \u0938\u093e\u0901\u0938 \u0915\u0947 \u0905\u092d\u094d\u092f\u093e\u0938 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902, \u0914\u0930 \u092d\u093e\u0930\u0940 \u0915\u0941\u091b \u092d\u0940 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0921\u0949\u0915\u094d\u091f\u0930 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0932\u0947\u0902\u0964",stage_postpartum_exercise_2:"\u0909\u091b\u0932-\u0915\u0942\u0926 \u0935\u093e\u0932\u0940 \u0915\u0938\u0930\u0924 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092a\u0947\u0932\u094d\u0935\u093f\u0915 \u092b\u093c\u094d\u0932\u094b\u0930 \u0914\u0930 \u0917\u0939\u0930\u0940 \u092a\u0947\u091f \u0915\u0940 \u092e\u093e\u0902\u0938\u092a\u0947\u0936\u093f\u092f\u093e\u0901 \u092e\u091c\u093c\u092c\u0942\u0924 \u0915\u0930\u0947\u0902\u0964",stage_postpartum_exercise_3:"\u0930\u093f\u0938\u093e\u0935, \u0926\u0930\u094d\u0926 \u092f\u093e \u092a\u0947\u091f \u0915\u0947 \u092c\u0940\u091a \u092e\u0947\u0902 \u0926\u0930\u093e\u0930 \u0926\u093f\u0916\u0947 \u0924\u094b \u0930\u0941\u0915\u0947\u0902 \u0914\u0930 \u0938\u0932\u093e\u0939 \u0932\u0947\u0902\u0964",stage_perimenopause_name:"\u092a\u0947\u0930\u093f\u092e\u0947\u0928\u094b\u092a\u0949\u091c\u093c",stage_perimenopause_desc:"\u092a\u0940\u0930\u093f\u092f\u0921 \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u0947 \u0935\u0930\u094d\u0937, \u091c\u092c \u0938\u093e\u0907\u0915\u093f\u0932 \u091b\u094b\u091f\u0940, \u0932\u0902\u092c\u0940 \u092f\u093e \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u091b\u0942\u091f \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939\u093e\u0901 \u0905\u0928\u0941\u092e\u093e\u0928 \u0915\u0947\u0935\u0932 \u0938\u0902\u0915\u0947\u0924 \u092d\u0930 \u0939\u0948\u0902\u0964",stage_perimenopause_nutrition_1:"\u0915\u0948\u0932\u094d\u0936\u093f\u092f\u092e \u0914\u0930 \u0935\u093f\u091f\u093e\u092e\u093f\u0928 D \u0915\u094b \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e \u0926\u0947\u0902 \u2014 \u0907\u0938 \u091a\u0930\u0923 \u092e\u0947\u0902 \u0939\u0921\u094d\u0921\u093f\u092f\u094b\u0902 \u0915\u093e \u0915\u094d\u0937\u092f \u0924\u0947\u091c\u093c \u0939\u094b\u0924\u093e \u0939\u0948\u0964",stage_perimenopause_nutrition_2:"\u092e\u093e\u0902\u0938\u092a\u0947\u0936\u093f\u092f\u093e\u0901 \u092c\u0928\u093e\u090f \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0939\u0930 \u092d\u094b\u091c\u0928 \u092e\u0947\u0902 \u092a\u094d\u0930\u094b\u091f\u0940\u0928 \u0930\u0916\u0947\u0902\u0964",stage_perimenopause_nutrition_3:"\u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0915\u0948\u092b\u093c\u0940\u0928, \u0936\u0930\u093e\u092c \u092f\u093e \u092e\u0938\u093e\u0932\u093e \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0939\u0949\u091f \u092b\u093c\u094d\u0932\u0948\u0936 \u092c\u0922\u093c\u093e\u0924\u0947 \u0939\u0948\u0902 \u092f\u093e \u0928\u0939\u0940\u0902, \u0914\u0930 \u0909\u0938\u0940 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u092c\u0926\u0932\u0947\u0902\u0964",stage_perimenopause_exercise_1:"\u0938\u092a\u094d\u0924\u093e\u0939 \u092e\u0947\u0902 \u0926\u094b \u092c\u093e\u0930 \u0936\u0915\u094d\u0924\u093f-\u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0939\u0921\u094d\u0921\u093f\u092f\u094b\u0902 \u0915\u0947 \u0918\u0928\u0924\u094d\u0935 \u0914\u0930 \u092e\u093e\u0902\u0938\u092a\u0947\u0936\u093f\u092f\u094b\u0902 \u0915\u0940 \u0930\u0915\u094d\u0937\u093e \u0915\u0930\u0924\u093e \u0939\u0948\u0964",stage_perimenopause_exercise_2:"\u0924\u0947\u091c\u093c \u091a\u0932\u0928\u093e \u092f\u093e \u0938\u0940\u0922\u093c\u093f\u092f\u093e\u0901 \u091a\u0922\u093c\u0928\u093e \u091c\u0948\u0938\u0940 \u092d\u093e\u0930 \u0938\u0939\u0928\u0947 \u0935\u093e\u0932\u0940 \u0917\u0924\u093f\u0935\u093f\u0927\u093f \u091c\u094b\u0921\u093c\u0947\u0902\u0964",stage_perimenopause_exercise_3:"\u0905\u092d\u0940 \u0938\u0902\u0924\u0941\u0932\u0928 \u0915\u093e \u0905\u092d\u094d\u092f\u093e\u0938 \u0906\u0917\u0947 \u091a\u0932\u0915\u0930 \u0917\u093f\u0930\u0928\u0947 \u0915\u093e \u0916\u093c\u0924\u0930\u093e \u0915\u093e\u092b\u093c\u0940 \u0918\u091f\u093e\u0924\u093e \u0939\u0948\u0964",stage_menopause_name:"\u092e\u0947\u0928\u094b\u092a\u0949\u091c\u093c",stage_menopause_desc:"\u092c\u093e\u0930\u0939 \u092e\u0939\u0940\u0928\u0947 \u092f\u093e \u0909\u0938\u0938\u0947 \u0905\u0927\u093f\u0915 \u092c\u093f\u0928\u093e \u092a\u0940\u0930\u093f\u092f\u0921\u0964 \u0938\u093e\u0907\u0915\u093f\u0932 \u0915\u093e \u0905\u0928\u0941\u092e\u093e\u0928 \u092c\u0902\u0926 \u0930\u0939\u0924\u093e \u0939\u0948, \u0914\u0930 \u0927\u094d\u092f\u093e\u0928 \u0932\u0915\u094d\u0937\u0923\u094b\u0902, \u0939\u0921\u094d\u0921\u093f\u092f\u094b\u0902 \u0914\u0930 \u0926\u0940\u0930\u094d\u0918\u0915\u093e\u0932\u093f\u0915 \u0938\u0947\u0939\u0924 \u092a\u0930 \u091a\u0932\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",stage_menopause_nutrition_1:"\u0915\u0948\u0932\u094d\u0936\u093f\u092f\u092e \u0914\u0930 \u0935\u093f\u091f\u093e\u092e\u093f\u0928 D \u0928\u093f\u092f\u092e\u093f\u0924 \u0930\u0916\u0947\u0902, \u0914\u0930 \u0938\u092e\u092f-\u0938\u092e\u092f \u092a\u0930 \u0938\u094d\u0924\u0930 \u091c\u093e\u0901\u091a\u0935\u093e\u090f\u0901\u0964",stage_menopause_nutrition_2:"\u092b\u093e\u0907\u092c\u0930 \u0914\u0930 \u0905\u091a\u094d\u091b\u0947 \u0935\u0938\u093e \u0939\u0943\u0926\u092f \u0915\u0940 \u0938\u0947\u0939\u0924 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u091c\u093f\u0938 \u092a\u0930 \u092e\u0947\u0928\u094b\u092a\u0949\u091c\u093c \u0915\u0947 \u092c\u093e\u0926 \u0905\u0927\u093f\u0915 \u0927\u094d\u092f\u093e\u0928 \u091a\u093e\u0939\u093f\u090f\u0964",stage_menopause_nutrition_3:"\u0921\u093e\u0907\u091f\u093f\u0902\u0917 \u0915\u0947 \u092c\u091c\u093e\u092f \u092d\u094b\u091c\u0928 \u0915\u0940 \u092e\u093e\u0924\u094d\u0930\u093e \u092a\u0930 \u0928\u091c\u093c\u0930 \u0930\u0916\u0947\u0902 \u2014 \u091a\u092f\u093e\u092a\u091a\u092f \u0927\u0940\u0930\u0947-\u0927\u0940\u0930\u0947 \u092c\u0926\u0932\u0924\u093e \u0939\u0948, \u0930\u093e\u0924\u094b\u0902\u0930\u093e\u0924 \u0928\u0939\u0940\u0902\u0964",stage_menopause_exercise_1:"\u0938\u092a\u094d\u0924\u093e\u0939 \u092e\u0947\u0902 \u0926\u094b \u092c\u093e\u0930 \u0936\u0915\u094d\u0924\u093f-\u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902; \u0907\u0938 \u091a\u0930\u0923 \u092e\u0947\u0902 \u092f\u0939\u0940 \u0938\u092c\u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093e\u0924\u094d\u092e\u0915 \u0906\u0926\u0924 \u0939\u0948\u0964",stage_menopause_exercise_2:"\u0939\u0943\u0926\u092f \u0914\u0930 \u092e\u0928 \u0915\u0947 \u0932\u093f\u090f \u0928\u093f\u092f\u092e\u093f\u0924 \u092e\u0927\u094d\u092f\u092e \u0915\u093e\u0930\u094d\u0921\u093f\u092f\u094b \u0930\u0916\u0947\u0902\u0964",stage_menopause_exercise_3:"\u092f\u094b\u0917 \u092f\u093e \u0938\u094d\u091f\u094d\u0930\u0947\u091a\u093f\u0902\u0917 \u091c\u0915\u0921\u093c\u0928 \u0914\u0930 \u0928\u0940\u0902\u0926 \u0915\u0940 \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964",prediction_title:"\u0906\u0917\u0947 \u0915\u094d\u092f\u093e",prediction_sub:"\u0906\u092a\u0915\u0947 \u0926\u0930\u094d\u091c \u0915\u093f\u090f \u092a\u0940\u0930\u093f\u092f\u0921 \u0938\u0947 \u0905\u0928\u0941\u092e\u093e\u0928\u093f\u0924",next_period:"\u0905\u0917\u0932\u093e \u092a\u0940\u0930\u093f\u092f\u0921 \u0905\u092a\u0947\u0915\u094d\u0937\u093f\u0924",ovulation:"\u0905\u0928\u0941\u092e\u093e\u0928\u093f\u0924 \u0913\u0935\u094d\u092f\u0941\u0932\u0947\u0936\u0928",fertile_window:"\u092b\u0930\u094d\u091f\u093e\u0907\u0932 \u0935\u093f\u0902\u0921\u094b",confidence_low:"\u0915\u092e \u092d\u0930\u094b\u0938\u093e",confidence_medium:"\u0920\u0940\u0915-\u0920\u093e\u0915 \u092d\u0930\u094b\u0938\u093e",confidence_high:"\u0905\u091a\u094d\u091b\u093e \u092d\u0930\u094b\u0938\u093e",confidence_note:"{{count}} \u092a\u0942\u0930\u0940 \u0938\u093e\u0907\u0915\u093f\u0932 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930",prediction_disclaimer:"\u092f\u0947 \u0906\u092a\u0915\u0940 \u0905\u092a\u0928\u0940 \u0926\u0930\u094d\u091c \u0924\u093e\u0930\u0940\u0916\u093c\u094b\u0902 \u0938\u0947 \u0932\u0917\u093e\u090f \u0917\u090f \u0905\u0928\u0941\u092e\u093e\u0928 \u0939\u0948\u0902, \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u0915\u0940\u092f \u0906\u0915\u0932\u0928 \u0928\u0939\u0940\u0902, \u0914\u0930 \u0917\u0930\u094d\u092d\u0928\u093f\u0930\u094b\u0927 \u0915\u0947 \u0932\u093f\u090f \u092d\u0930\u094b\u0938\u0947\u092e\u0902\u0926 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964",prediction_empty_title:"\u0905\u092d\u0940 \u0905\u0928\u0941\u092e\u093e\u0928 \u0932\u0917\u093e\u0928\u0947 \u0915\u094b \u0915\u0941\u091b \u0928\u0939\u0940\u0902",prediction_empty_sub:"\u0905\u092a\u0928\u0947 \u092a\u093f\u091b\u0932\u0947 \u092a\u0940\u0930\u093f\u092f\u0921 \u0915\u093e \u092a\u0939\u0932\u093e \u0926\u093f\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902 \u2014 \u0905\u0928\u0941\u092e\u093e\u0928 \u0924\u0941\u0930\u0902\u0924 \u0926\u093f\u0916\u0947\u0917\u093e \u0914\u0930 \u0939\u0930 \u0928\u0908 \u0938\u093e\u0907\u0915\u093f\u0932 \u0915\u0947 \u0